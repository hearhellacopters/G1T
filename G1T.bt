//
//   ###################################################################
//   #  IF THIS G1T IS IN AN EFFECT PACK: THE ENTRY ORDER IS A CONTRACT #
//   ###################################################################
//
//   When a G1T ships beside G1FX and G1EM files, the effects address its textures
//   BY POSITION and nothing else. The engine loads the whole G1T as one
//   CDX11TexContext, which is just { int m_texNum; TEXELEM *m_pTexTable[]; }, and
//   an effect resolves a texture as m_pTexTable[nTexID] where nTexID is an
//   integer stored in the G1FX. No name, no hash, no id, in either direction.
//   This file has no idea anything is pointing at it.
//
//   So for a G1T inside an effect pack:
//     * Inserting, removing or reordering ANY entry silently repoints every
//       effect that indexes past it. Nothing errors, at load or at draw; an out
//       of range index just binds a null texture and the draw still happens.
//     * A multi map effect material occupies a CONSECUTIVE RUN of entries. The
//       base map is nTexID, the normal map and the rest are nTexID+1, nTexID+2
//       and so on. Splitting such a run apart breaks the material even though
//       every individual texture is still present.
//     * Appending at the END is the only edit that is safe by construction.
//
//   None of this applies to a G1T used by a G1M, which binds through the
//   material and texture stage tables instead. It is specific to effect packs.
//   The full chain, with addresses, is in G1FX.bt under ASSET BINDING and in
//   G1EM.bt under HOW A G1EM GETS A TEXTURE.
//
//   PROVENANCE
//   Breadcrumbs for re-checking this against a future build. Symbol names are
//   the durable handle; the addresses only mean anything in the build named
//   beside them, so always match on the name first.
//
//   Builds used here:
//     [WIN]  SAN14_EN.exe.unpacked.exe    Windows x64,   imagebase 0x140000000
//     [OES2] libMusouSPS_sandbox.so       Android ARM32, imagebase 0
//                                         ships the S_* structure and enum
//                                         declarations, not just the code
//
//   Header and texture headers
//     [OES2] ktgl::S_G1T_HEADER (28 bytes: magic, version, fileBC, localBC,
//            texNum, platform, attrBC), S_G1T_TEX_HEADER (8, all bitfields),
//            S_G1T_TEX_HEADER_EX (12), S_G1T_TEX_ATTR_HEADER (4)
//     [OES2] S_G1T_HEADER::SizeOfBasic                     0x349D58
//     [OES2] S_G1T_HEADER::GetJumpTableSize                0x349E1C
//     [OES2] S_G1T_HEADER::IsNotSupportedVersion           0x349D78
//     [OES2] S_G1T_TEX_HEADER::HasExHeader                 0x349CC4
//     [OES2] S_G1T_TEX_HEADER_EX::S_G1T_TEX_HEADER_EX      0x349C58
//     [OES2] COES2GraphicsDevice::ReadG1THeader            0x349DD8
//     [OES2] COES2GraphicsDevice::CreateTexContextBody     0x339D98
//     [OES2] COES2GraphicsDevice::GetSkipLevelNumAndG1TTexHeader  0x33B0C4
//     THE SKIP LEVEL IS NOT A FILE FIELD. Traced on [D182-64]:
//       CreateTexContextSeed 0x12EA2D0 -> COES2TexContext::create 0x1308AC0,
//       whose signature carries TWO u8s -> Element::as 0x1300A70 stores the
//       skip level at elem+30 -> Element::load_planar 0x1301030 ->
//       Element::skip 0x13012A4 -> stream->Skip(bytes).
//       Nothing in the .g1t supplies it; the file always holds the FULL mip
//       chain and the caller decides how much to drop. Parse every level.
//     DO NOT confuse it with minMipLevel. Element::as writes both:
//       elem+29 = texHdrEx[8] & 0xF   <- from the FILE (minMipLevel)
//       elem+30 = skipLevel            <- from the CALLER
//     Element::skip VALIDATES first and refuses the load on a mismatch: type
//     nibble vs elem[51]>>5, format byte vs elem[50], type 3 with non-zero
//     depth exponent, and max(1, dim >> skip) against elem+44/46/48.
//     Its byte sum clamps EACH AXIS independently with max(1, ..) - a 256x1
//     texture keeps generating levels after the short axis bottoms out, so
//     (w>>i)*(h>>i) without the clamp under-counts the tail. See G1T.md.
//     [WIN]  ktgl::CDX11GraphicsDevice::ReadG1THeader
//
//   The attribute chain that TEX_EX_TYPE indexes
//     [OES2] S_G1T_TEX_ATTR_HEADER::GetNextUsage           0x349D20
//            next = this + dataWC + 1 on a 4 byte struct, so each record is a
//            4 byte header followed by 4 * dataWC bytes of payload
//     [OES2] COES2TexHandleUtil::GetTexAttrData            0x35151C
//            loops while !ktgluse and then still matches the record it stopped
//            on, so ktgluse marks the LAST attribute rather than meaning
//            "already consumed". A walker that skips it drops the final entry.
//     [HW] CCafeTexHandleUtil::GetTexAttrData            0x2821D84
//            the same walk on big endian PowerPC, where the byte offsets are
//            explicit rather than bitfields, so it is worth quoting:
//              if (p[0] == usage) return p + 2;              // payload at +4
//              while (!((BYTE*)p)[3])                        // while !ktgluse
//                  p += 2 * ((BYTE*)p)[2] + 2;               // += 4 + 4*dataWC
//            usage u16 at +0, dataWC byte at +2, ktgluse byte at +3, on a build
//            with the opposite endianness. The layout is not bitfield order
//            dependent.
//
//   WHO WRITES ktgluse. It is stamped by the loader, not authored in the file:
//     [HW] CG1tHelperCafe::SetAttrHeader                  0x221A6BC
//     [HW] CG1tHelperCafe::_CPR111__SetAttrHeader         0x221A748
//            walks attrNum headers, writing ktgluse = 0 on every one except the
//            last, which gets 1, and advancing by 4 * (dataWC + 1) each time
//     [HW] CG1tHelperCafe::unGetAttrHeaderNum             0x221A12C
//            = *(uint32*)texHeader & 0xF, which on big endian is the low nibble
//            of byte 3, i.e. attrNum. So the count comes from the texture header
//            and the loader relinks the chain into its runtime buffer.
//   That reconciles the two readings of this field: the original note here that
//   "the system writes a 1" was right about who writes it. What it means is
//   "last in the chain", not "already consumed", and it is set during load, so
//   a value sitting in a file is not necessarily meaningful until relinked.
//
//   The same routine exists in the later factored form, on the opposite
//   endianness, doing exactly the same thing:
//     [DFFOO64] ktgl::graphics::oes2::consume(S_G1T_TEX_ATTR_HEADER &,
//                                             const S_G1T_TEX_HEADER &)   0xD3D930
//         if (h.dword0 >> 28) {                     // attrNum
//             while (...) { p->ktgluse = 0; p += 4 * p->dataWC + 4; }
//             p->ktgluse = 1;                       // last
//         }
//   attrNum is the top 4 bits of dword 0 on little endian and the low nibble of
//   byte 3 on big endian, which is the same field either way. Two builds of
//   opposite byte order agree on all three points: the count comes from attrNum,
//   the stride is 4 + 4 * dataWC, and ktgluse is stamped 0 on every entry but
//   the last.
//     [DF32] ktgl::graphics::oes2::consume                 0x7FC3B0
//            The 32 bit build of the same game, byte for byte the same routine.
//            Adds no new information, recorded only so the next person does not
//            re-derive it. Note that its callers cannot be traced in that build:
//            IDA attributes the PLT veneer to dozens of unrelated libc++
//            functions, so where the S_G1T_TEX_HEADER it reads comes from is not
//            answerable there.
//     [OES2] CWaterShaderBase::GetNormalTextureCompressType 0x2FEBF4
//     [OES2] CNormalMapAccessory::OnCommitChanges          0x32BF84
//            the only two callers, both passing usage 3. Payload there is
//            {u32 flags, u32 value} with flags bit 0 gating the value, that bit
//            being KTGL_SHLIB_NORMALMAP_ATTR_PARAM_FLG_COMPRESS. The matching
//            KTGL_SHLIB_ENVMAP_TEX_PARAM_FLG suggests {flags, value} with a
//            per usage flag enum is the general shape.
//
//   KTGL_TEX_ATTR_USAGE, the engine's own enum for the usage field, i.e. for
//   TEX_EX_TYPE below. IT GROWS BETWEEN BUILDS, which is the direct evidence for
//   these being per system:
//
//     value  [OES2] (6 values)   [WIN] (18 values)        TEX_EX_TYPE below
//       0    ENVMAP              ENVMAP                   (0 treated as NONE)
//       1    IBL_SPECULAR        IBL_SPECULAR             CHANNEL_SWAP
//       2    IBL_DIFFUSE         IBL_DIFFUSE              NO_ALPHA
//       3    NORMALMAP           NORMALMAP                NORMAL_MAP        <-
//       4    IBL_SHADOW          IBL_SHADOW               COLOR_TEST
//       5    TLUT                TLUT                     N3DS_Wii_SWIZZLE
//       6    (NUM, end)          CAFE_SWIZZLE             WiiU_SWIZZLE      <-
//       7                        SH_IRRADIANCE_VOLUME     PS4_PLANE_ARRAY
//       8                        ARRAY                    PSVITA_PS5_SWIZZLE
//       9                        CUBICARRAY_SHADOW        ???
//      10                        PLANARARRAY_SHADOW       ???
//      11                        CUBICARRAY_ESM           ???
//      12                        PLANARARRAY_ESM          ???
//      13                        METALNESSMAP             ???
//      14                        AMBIENT_SPECULAR         ???
//      15                        SDF                      ???
//      16                        TONEMAP                  ???
//      17                        LIGHTMAP                 ???
//      18                        (NUM, end)               ???
//
//   Two values line up exactly and are worth trusting: 3 NORMALMAP, which also
//   agrees with the only two [OES2] callers, and 6 CAFE_SWIZZLE, since Cafe is
//   Nintendo's codename for the Wii U. 5 TLUT is a GameCube and Wii palette
//   concept, so N3DS_Wii there is at least the right family, and 8 ARRAY is
//   plausibly the same thing as the PS4 plane array entry without the platform
//   being part of the name.
//
//   The disagreements are real and unresolved. The hand mapping was made from
//   observed behaviour and the engine names are declarations, so where they
//   differ it may be that one build's usage 1 genuinely does a channel swap
//   while another's means IBL specular, or that the behavioural reading was off.
//   Neither list is being treated as authoritative here. What the [WIN] set does
//   settle is 9..17, which were unknown in the table below.
//
//   Caveat: nothing in either binary is actually typed with this enum, so it is
//   the declared set rather than proof of the field's type.
//
//     [OES2] KTGL_G1T_VERSION  0020 0030 0040 0050 0060, CURRENT = 0060
//     [WIN]  KTGL_G1T_VERSION  0020 0030 0040 0050 0060 0061 0062 0063 0064,
//            CURRENT = 0064
//     Later builds go further. The corpus holds 0065, and the Nioh 3 demo adds
//     0066, the streaming variant, which marks its textures with the new
//     EX_SWIZZLE value ZLIB_COMPRESSED - see S_G1T_COMPED near the end of this
//     template. Its loader [nioh3] sub_1406697D0 reads the 20 byte base header,
//     and for version >= 0050 pulls 8 more bytes and requires the platform word
//     to be 0, 10 or 14.
//     [WIN]  S_G1T_TEX_HEADER_EX names the 12 bit field after minMipLevel
//            "arrayLength", which confirms EX_ARRAY_COUNT below; [OES2] has it
//            as padding, so that build predates array textures
//     [both] KTGL_TEXTURE_TYPE, KTGL_GD_TEXFILTER, KTGL_GD_TEXADDRESS
//
//   [DFFOO] libDelta.so, Android ARM32, imagebase 0, declares no structures but
//   carries a later, cleanly factored reader worth reading if this template ever
//   needs reworking. It is free functions in a namespace rather than one big
//   CreateTexContext, so each step is isolated:
//     [DFFOO] ktgl::graphics::oes2::g1t_header                    0xB2DDF8
//     [DFFOO] ktgl::graphics::oes2::skip_jump_table               0xB2E0A0
//     [DFFOO] ktgl::graphics::oes2::g1t_image_bytes               0xB2DCB8
//     [DFFOO] ktgl::graphics::oes2::adjust                        0xB2DF34, 0xB2E084
//     [DFFOO] ktgl::graphics::oes2::consume                       0xB2E690
//     [DFFOO] ktgl::graphics::oes2::load                          0xB2E580, 0xB2E638
//     [DFFOO] ktgl::graphics::oes2::texture::Element::g1t_attr    0xB32F04
//     [DFFOO] ktgl::graphics::oes2::texture::Element::as_planar   0xB32F54
//     [DFFOO] ktgl::graphics::oes2::texture::Element::as_cube     0xB331F4
//     [DFFOO] ktgl::graphics::oes2::texture::Element::as_volume   0xB33A70
//     [DFFOO] ktgl::graphics::oes2::texture::Element::load_planar 0xB34768
//     [DFFOO] ktgl::graphics::oes2::texture::Element::load_cube   0xB34AC0
//     [DFFOO] ktgl::graphics::oes2::texture::Element::load_volume 0xB34DD8
//   g1t_image_bytes is the size authority and confirms the alpha atlas note
//   below from the engine side: it is w*h*d*bpp/8 summed over the mip chain with
//   each dimension clamped to 1, and NOTHING else - no offset is ever consulted.
//   Its bpp comes from ktgl::graphics::oes2::opengl::texture_format 0xB2F364,
//   an 8 byte per format lookup at 0xCE15F0 + 440 with bpp at +6, which rejects
//   any format above 0x70. Reading that table directly: ETC1 0x56 = 4 bpp,
//   PVRT4 0x58 = 4, while ETC1RGBETC1A 0x6F = 8 and PVRT4RGBPVRT4A 0x70 = 8.
//   So the engine already carries the doubled figure and only the packer's
//   FILE_SIZE / offset arithmetic is wrong.
//
//   The as_/load_ split by texture type matches KTGL_TEXTURE_TYPE, and
//   skip_jump_table names the texNum*4 offset table explicitly. g1t_attr itself
//   is only a setter, storing the attribute pointer at +8 of the element, so the
//   attribute walk is in its caller.
//   That build declares no KTGL_TEX_ATTR_USAGE, so it adds nothing to the table
//   question above.
//
//   [DFFOO64] a later DFFOO, Android arm64, has the same namespace with more in
//   it. New since the arm32 one, and worth knowing because it dates the feature:
//     [DFFOO64] texture::Element::as                    0xD44E08
//     [DFFOO64] texture::Element::as_plane_array        0xD4629C   <- new
//     [DFFOO64] texture::Element::load_plane_array      0xD465CC   <- new
//     [DFFOO64] texture::Element::skip                  0xD4563C   <- new
//     [DFFOO64] texture::Element::as_planar / as_cube / as_volume
//                                                       0xD44FE8 / 0xD451C8 / 0xD46220
//   So plane array, the PLANE_ARRAY entry of S_GT1_LOAD_TYPE below, arrived
//   between those two builds. The arm32 one has only planar, cube and volume.
//
//   Element::as is the header decoder rather than a type dispatcher, and it
//   spells out the packing of texture header dword 0 unambiguously:
//     width  = 1 << ((dword0 >> 16) & 0xF)      tw
//     height = 1 << ((dword0 >> 20) & 0xF)      th
//     depth  = 1 << ((dword0 >> 24) & 0xF)      td
//     fmt    = (dword0 >> 8) & 0xFF
//     levels = (dword0 >> 4) & 0xF,  texType = dword0 & 0xF
//   which matches the declared S_G1T_TEX_HEADER bitfields, and confirms that the
//   three dimensions are stored as power of two exponents, not as sizes.
//   It also reads the EX header at +4 for mipLodBias, the low nibble at +8 for
//   minMipLevel and the byte at +11 for colorSpace, agreeing with the layout
//   used below.
//
//   Its real signature, from the mangled name rather than the decompiler, is
//     Element::as(oes2::opengl::context::Suite &,
//                 const S_G1T_TEX_HEADER &, const S_G1T_TEX_HEADER_EX &,
//                 unsigned char, unsigned char)
//   and the eight byte scratch it decodes is not a mystery structure: it is the
//   output of ktgl::graphics::oes2::adjust(S_G1T_TEX_HEADER &,
//   const S_G1T_TEX_HEADER &, uint, uint) at 0xD3D1F4, so it is simply an
//   adjusted copy of the texture header, dword 0 then dword 1. IDA mislabels
//   that call as a std::bad_weak_ptr destructor because it resolves the PLT stub
//   to the wrong import; the argument types in the mangled name give it away.
//
//   Dword 1 is then unpacked exactly as declared:
//     bits  0..11  addrU, addrV, addrW      three 4 bit modes, copied as a group
//     bits 12..19  magFilter, minFilter
//     bits 20..23  mipFilter
//   with one behaviour worth knowing: mipFilter is forced to zero when
//   (dword0 & 0xE0) == 0, that is when levels is below 2. A single level texture
//   gets no mip filtering regardless of what the file asks for.
//
//   Other helpers in that namespace, with real signatures:
//     [DFFOO64] oes2::g1t_header(IInputStream &, S_G1T_HEADER &)          0xD3D074
//     [DFFOO64] oes2::skip_jump_table(IInputStream &, const S_G1T_HEADER &) 0xD3D348
//     [DFFOO64] oes2::adjust(S_G1T_TEX_HEADER &, uint, uint)              0xD3D208
//     [DFFOO64] oes2::load(uint &, S_G1T_TEX_HEADER &, S_G1T_TEX_HEADER_EX &,
//                          IInputStream &, const S_G1T_HEADER &)          0xD3D7C4
//     [DFFOO64] Element::skip(IInputStream &, u8, const S_G1T_TEX_HEADER &,
//                             const opengl::TextureFormat &, u16) const   0xD4563C
//   The load overloads taking both headers plus the stream are the closest thing
//   to a single readable definition of "one texture entry" in any build seen so
//   far, and are the place to start if this template ever needs reworking.
//
//   Checked on samples: localBC == 28 + 4 * texNum on 10 of 10, which fixes both
//   the header size and the fact that the attribute table and the offset table
//   are two separate texNum*4 blocks. fileBC disagreed on exactly the two ETC1
//   alpha atlas files, the known packer bug.
//------------------------------------------------

LittleEndian();

typedef enum <ubyte>
{
  KTGL_PIXEL_FORMAT_RGBA8             = 0x00,
  KTGL_PIXEL_FORMAT_BGRA8             = 0x01,
  KTGL_PIXEL_FORMAT_R32F              = 0x02,
  KTGL_PIXEL_FORMAT_RGBA16F           = 0x03,
  KTGL_PIXEL_FORMAT_RGBA32F           = 0x04,
  KTGL_PIXEL_FORMAT_Z24S8             = 0x05,
  KTGL_PIXEL_FORMAT_DXT1              = 0x06,
  KTGL_PIXEL_FORMAT_DXT3              = 0x07,
  KTGL_PIXEL_FORMAT_DXT5              = 0x08,
  KTGL_PIXEL_FORMAT_TILE_RGBA8        = 0x09,
  KTGL_PIXEL_FORMAT_TILE_BGRA8        = 0x0A,
  KTGL_PIXEL_FORMAT_TILE_R32F         = 0x0B,
  KTGL_PIXEL_FORMAT_TILE_RGBA16F      = 0x0C,
  KTGL_PIXEL_FORMAT_TILE_RGBA32F      = 0x0D,
  KTGL_PIXEL_FORMAT_RGB10FA2F         = 0x0E,
  KTGL_PIXEL_FORMAT_A8                = 0x0F,
  KTGL_PIXEL_FORMAT_TILE_DXT1         = 0x10,
  KTGL_PIXEL_FORMAT_TILE_DXT3         = 0x11,
  KTGL_PIXEL_FORMAT_TILE_DXT5         = 0x12,
  KTGL_PIXEL_FORMAT_TILE_Z24S8        = 0x13,
  KTGL_PIXEL_FORMAT_Z16               = 0x14,
  KTGL_PIXEL_FORMAT_TILE_Z16          = 0x15,
  KTGL_PIXEL_FORMAT_R16               = 0x16,
  KTGL_PIXEL_FORMAT_TILE_R16          = 0x17,
  KTGL_PIXEL_FORMAT_TILE_A8           = 0x18,
  KTGL_PIXEL_FORMAT_B5G6R5            = 0x19,
  KTGL_PIXEL_FORMAT_B5G5R5A1          = 0x1A,
  KTGL_PIXEL_FORMAT_B4G4R4A4          = 0x1B,
  KTGL_PIXEL_FORMAT_TILE_B5G6R5       = 0x1C,
  KTGL_PIXEL_FORMAT_TILE_B5G5R5A1     = 0x1D,
  KTGL_PIXEL_FORMAT_TILE_B4G4R4A4     = 0x1E,
  KTGL_PIXEL_FORMAT_Z24FS8            = 0x1F,
  KTGL_PIXEL_FORMAT_TILE_Z24FS8       = 0x20,
  KTGL_PIXEL_FORMAT_BGRX8             = 0x21,
  KTGL_PIXEL_FORMAT_TILE_BGRX8        = 0x22,
  KTGL_PIXEL_FORMAT_GR16              = 0x23,
  KTGL_PIXEL_FORMAT_TILE_GR16         = 0x24,
  KTGL_PIXEL_FORMAT_TILE_B5G5R5A3     = 0x25,
  KTGL_PIXEL_FORMAT_TILE_BG8          = 0x26,
  KTGL_PIXEL_FORMAT_TILE_RA8          = 0x27,
  KTGL_PIXEL_FORMAT_TILE_B8           = 0x28,
  KTGL_PIXEL_FORMAT_TILE_G8           = 0x29,
  KTGL_PIXEL_FORMAT_TILE_R8           = 0x2A,
  KTGL_PIXEL_FORMAT_TILE_L4           = 0x2B,
  KTGL_PIXEL_FORMAT_TILE_L8           = 0x2C,
  KTGL_PIXEL_FORMAT_TILE_LA4          = 0x2D,
  KTGL_PIXEL_FORMAT_TILE_LA8          = 0x2E,
  KTGL_PIXEL_FORMAT_TILE_Z4           = 0x2F,
  KTGL_PIXEL_FORMAT_TILE_Z8           = 0x30,
  KTGL_PIXEL_FORMAT_TILE_INDEX4       = 0x31,
  KTGL_PIXEL_FORMAT_TILE_INDEX8       = 0x32,
  KTGL_PIXEL_FORMAT_TILE_INDEX14X2    = 0x33,
  KTGL_PIXEL_FORMAT_R5G6B5            = 0x34,
  KTGL_PIXEL_FORMAT_R5G5B5A1          = 0x35,
  KTGL_PIXEL_FORMAT_R4G4B4A4          = 0x36,
  KTGL_PIXEL_FORMAT_INDEX4            = 0x37,
  KTGL_PIXEL_FORMAT_INDEX8            = 0x38,
  KTGL_PIXEL_FORMAT_INDEX16           = 0x39,
  KTGL_PIXEL_FORMAT_INDEX32           = 0x3A,
  KTGL_PIXEL_FORMAT_TILE_R5G6B5       = 0x3B,
  KTGL_PIXEL_FORMAT_TILE_R5G5B5A1     = 0x3C,
  KTGL_PIXEL_FORMAT_TILE_R4G4B4A4     = 0x3D,
  KTGL_PIXEL_FORMAT_TILE_INDEX16      = 0x3E,
  KTGL_PIXEL_FORMAT_TILE_INDEX32      = 0x3F,
  KTGL_PIXEL_FORMAT_R10G10B10A2       = 0x40,
  KTGL_PIXEL_FORMAT_R16G16B16A16      = 0x41,
  KTGL_PIXEL_FORMAT_TILE_R10G10B10A2  = 0x42,
  KTGL_PIXEL_FORMAT_TILE_R16G16B16A16 = 0x43,
